* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt text eol=lf
*.csv text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.xlsx binary

# 原始网页必须逐字节保留，避免跨平台换行转换破坏SHA-256。
data/raw/pages/*.html binary
data/raw/fragments/*.html text eol=lf
